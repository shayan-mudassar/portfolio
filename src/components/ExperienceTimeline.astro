---
import { profile } from "../data/profile";
---
<div class="timeline">
  {profile.experience.map((role, index) => (
    <div class="timeline-item" style={`--i: ${index};`}>
      <div class="timeline-marker" aria-hidden="true"></div>
      <details open={index === 0}>
        <summary>
          <div>
            <div class="timeline-title">
              <span>{role.company}</span>
              <span class="timeline-title-separator">-</span>
              <span>{role.role}</span>
            </div>
            <div class="timeline-role">{role.location}</div>
            {role.impact ? <div class="timeline-impact">{role.impact}</div> : null}
          </div>
          <div class="timeline-role">{role.period}</div>
        </summary>
        <div class="timeline-body">
          <ul>
            {role.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          {role.roles?.length ? (
            <div class="career-stack" aria-label={`${role.company} role progression`}>
              {role.roles.map((step) => (
                <div class="career-step">
                  <div class="career-step-header">
                    <div class="career-step-title">{step.title}</div>
                    <div class="career-step-meta">{step.period}</div>
                  </div>
                  <ul>
                    {step.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                  <div class="career-tech">Tech: {step.tech}</div>
                </div>
              ))}
            </div>
          ) : null}
          <div class="timeline-panels">
            <div class="panel-box">
              <strong>What I shipped</strong>
              <ul>
                {role.shipped.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="panel-box">
              <strong>How it ran in prod</strong>
              <ul>
                {role.ranInProd.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </details>
    </div>
  ))}
</div>
